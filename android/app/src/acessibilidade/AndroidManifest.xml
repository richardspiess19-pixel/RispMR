<?xml version="1.0" encoding="utf-8"?>
<!-- Only in the "acessibilidade" APK: the accessibility reader. The default ("shizuku") APK
     leaves it out, so Play Protect does not block installing it outside the store. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Modo jogo: reads the VR Box while a game is open (Settings > Accessibility). -->
        <service
            android:name=".game.GameModeService"
            android:exported="false"
            android:label="@string/game_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/game_mode_service" />
        </service>
    </application>
</manifest>
