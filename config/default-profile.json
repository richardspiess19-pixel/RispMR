{
  "schema": 1,
  "type": "vrbq-profile-template",
  "description": "Default settings applied to new profiles and used by 'Restore defaults'. Mappings are empty on purpose: new profiles start clean.",
  "profile": {
    "id": "template",
    "name": "New Profile",
    "description": "",
    "mappings": [],
    "sticks": {
      "left": {
        "mode": "virtual_stick",
        "smoothing": 0.10,
        "returnSpeed": 6.0,
        "x": { "sensitivity": 1.0, "deadzone": 0.08, "curve": 1.0, "max": 1.0, "invert": false },
        "y": { "sensitivity": 1.0, "deadzone": 0.08, "curve": 1.0, "max": 1.0, "invert": false }
      },
      "right": {
        "mode": "relative_mouse",
        "smoothing": 0.15,
        "returnSpeed": 8.0,
        "x": { "sensitivity": 1.0, "deadzone": 0.05, "curve": 1.2, "max": 1.0, "invert": false },
        "y": { "sensitivity": 1.0, "deadzone": 0.05, "curve": 1.2, "max": 1.0, "invert": false }
      }
    },
    "buttons": {
      "analogThreshold": 0.5,
      "digitalAnalogValue": 1.0
    }
  }
}
